  "motion/fast": {
    "$type": "duration",
    "$value": "120ms",
    "$description": "press, toggle, chip select; easing cubic-bezier(0.2,0,0,1)"
  },
  "motion/base": {
    "$type": "duration",
    "$value": "200ms",
    "$description": "re-rank, row insert; cubic-bezier(0.2,0,0,1)"
  },
  "motion/slow": {
    "$type": "duration",
    "$value": "320ms",
    "$description": "winner settle: 8pt rise + 0.98\u21921 scale, opacity 0\u21921; cubic-bezier(0.16,1,0.3,1). Reduced motion: 120ms crossfade only"
  },
  "motion/spring/sheet": {
    "$type": "spring",
    "$value": {
      "stiffness": 420,
      "damping": 42,
      "mass": 1,
      "dampingRatio": 1.02
    },
    "$description": "Critically damped: no overshoot. SwiftUI .spring(response:0.31, dampingFraction:1.0)"
